# /etc/systemd/system/phhtp.service
#
#   sudo cp target/release/phhtp /usr/local/bin/phhtp
#   sudo cp deploy/phhtp.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now phhtp
#   sudo systemctl edit phhtp     # to override PHHTP_RUNTIME / PHHTP_SECRET
[Unit]
Description=phhtp HTTP/1.1 server
After=network-online.target
Wants=network-online.target

[Service]
Environment=PHHTP_RUNTIME=tokio
Environment=PHHTP_SECRET=change-me
ExecStart=/usr/local/bin/phhtp --runtime ${PHHTP_RUNTIME} --bind 0.0.0.0:8080
Restart=on-failure
RestartSec=1
LimitNOFILE=65536
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
